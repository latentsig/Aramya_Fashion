{
  "expo": {
    "name": "Aramya Fashion House",
    "slug": "aramya-fashion-house",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/aramya-512.png",
    "scheme": "aramya",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/aramya-512.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8C1721",
        "foregroundImage": "./assets/images/aramya-512.png"
      },
      "package": "com.aramya.fashion",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/aramya-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8C1721",
          "image": "./assets/images/aramya-192.png",
          "imageWidth": 152
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
