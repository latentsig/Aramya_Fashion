# Android emulator: use 10.0.2.2 to reach the development machine's localhost.
# A physical phone must use the development machine's LAN IP address instead.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Point this at Vite's local /media path while R2 migration remains pending.
# Production must use the approved R2-backed storefront media domain.
EXPO_PUBLIC_MEDIA_BASE_URL=http://10.0.2.2:5173/media
