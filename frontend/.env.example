# Leave empty to use the same-origin /api path and Vite's local API proxy.
# Set to an HTTPS API origin for deployed storefronts.
VITE_API_BASE_URL=
# Public HTTPS delivery base URL for approved R2 media, e.g. https://media.example.com
# Leave empty while the storefront uses its preserved local legacy assets.
VITE_MEDIA_BASE_URL=
