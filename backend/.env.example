API_ADDR=127.0.0.1:18080
DATABASE_URL=postgres://aramya_app:<local-password>@localhost:5432/aramya?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:4173
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
CSRF_SECRET=<base64url-encoded-32-random-bytes>
AUTH_SESSION_TTL=168h
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Optional. If set, exposes /metrics and requires this bearer token. Use a
# random value of at least 32 characters and configure Prometheus to match.
PROMETHEUS_BEARER_TOKEN=
# Optional admin media uploads. Leave all six blank to disable R2-backed uploads.
# Use a restricted R2 API token, separate private staging and approved-media buckets,
# and an HTTPS custom domain that serves only approved media.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_UPLOAD_BUCKET=
CLOUDFLARE_R2_APPROVED_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
# Optional Razorpay test mode only. The API rejects live-mode key IDs.
# Keep API and webhook secrets server-side; never copy either secret into frontend env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payment stays disabled unless test credentials are configured and this is true.
# Set true only after confirming the database subtotal is the complete payable amount.
CHECKOUT_PRICING_FINAL=false
