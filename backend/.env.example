API_ADDR=127.0.0.1:18080
DATABASE_URL=postgres://aramya_app:<local-password>@localhost:5432/aramya?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:4173
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
CSRF_SECRET=<base64url-encoded-32-random-bytes>
AUTH_SESSION_TTL=168h
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Optional. If set, exposes /metrics and requires this bearer token. Use a
# random value of at least 32 characters and configure Prometheus to match.
PROMETHEUS_BEARER_TOKEN=
